# Project N.O.M.A.D. - Local Learning Environment
# Copy this file to .env and fill in the values before running docker compose up.
#
# APP_KEY must be at least 16 characters. Generate one with:
#   openssl rand -hex 16
APP_KEY=REPLACE_WITH_RANDOM_STRING_MIN_16_CHARS

# URL is the address you will use to access the admin interface.
# For local use, keep this as http://localhost:8080
URL=http://localhost:8080

# Database passwords - set matching values in both variables below.
DB_PASSWORD=nomad_db_pass
MYSQL_ROOT_PASSWORD=nomad_root_pass
MYSQL_PASSWORD=nomad_db_pass

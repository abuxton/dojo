#!/bin/sh

set -eu

root="${APPLE_INTELLIGENCE_PLATFORM_DIR:-$HOME/Library/IntelligencePlatform}"
database="$root/graph.db"

usage() {
  cat <<'EOF'
Usage: intelligence-platform <command> [argument]

Read-only inspection of the local Apple Intelligence Platform store.

Commands:
  inventory               List files in the platform directory.
  tables                  List tables in graph.db.
  schema [table-name]     Show graph.db schema, optionally for one table.
  walk                    Print a safe, educational schema exploration sequence.
  profile <table-name>    Show aggregate-only metrics for entity or stable_graph.
  predicate-summary       Count the most common stable_graph predicate codes.
  query "<read-only SQL>" Run one SELECT, WITH, EXPLAIN, or PRAGMA statement.

Set APPLE_INTELLIGENCE_PLATFORM_DIR to inspect a fixture directory instead.
EOF
}

require_database() {
  if [ ! -f "$database" ]; then
    printf 'graph.db not found at %s\n' "$database" >&2
    printf 'The platform may be unavailable, or this terminal may need Full Disk Access.\n' >&2
    exit 1
  fi
}

run_sql() {
  result=$(sqlite3 -readonly -header -column "$database" "$1" 2>&1) || {
    printf 'Cannot read %s: macOS denied this terminal access or the database is unavailable.\n' "$database" >&2
    printf 'Grant this terminal Full Disk Access in System Settings, then try again.\n' >&2
    return 1
  }
  printf '%s\n' "$result"
}

walk() {
  cat <<'EOF'
Safe schema walk (no records are displayed):

1. List table names:
   intelligence-platform tables
2. Read the raw-fact shape:
   intelligence-platform schema entity
3. Read the derived-relationship shape:
   intelligence-platform schema stable_graph
4. Count structure, not values:
   intelligence-platform profile entity
   intelligence-platform profile stable_graph
5. Inspect relationship vocabulary, not personal records:
   intelligence-platform predicate-summary

Use query only after you understand the schema and have a narrow, local question.
EOF
}

command="${1:-}"

case "$command" in
  inventory)
    if [ ! -d "$root" ]; then
      printf 'Intelligence Platform directory not found at %s\n' "$root" >&2
      exit 1
    fi
    files=$(find "$root" -maxdepth 1 -type f -print 2>/dev/null) || {
      printf 'Cannot list %s: macOS denied this terminal access.\n' "$root" >&2
      printf 'Grant this terminal Full Disk Access in System Settings, then try again.\n' >&2
      exit 1
    }
    printf '%s\n' "$files" | sort
    ;;
  tables)
    require_database
    run_sql "SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name;"
    ;;
  schema)
    require_database
    table="${2:-}"
    if [ -n "$table" ]; then
      case "$table" in
        *[!A-Za-z0-9_]*|'')
          printf 'Table names may contain only letters, numbers, and underscores.\n' >&2
          exit 2
          ;;
      esac
      run_sql "SELECT sql FROM sqlite_master WHERE type IN ('table', 'view') AND name = '$table';"
    else
      run_sql "SELECT sql FROM sqlite_master WHERE type IN ('table', 'view') ORDER BY name;"
    fi
    ;;
  walk)
    walk
    ;;
  profile)
    require_database
    table="${2:-}"
    case "$table" in
      entity|stable_graph)
        run_sql "SELECT '$table' AS table_name,
                        COUNT(*) AS rows,
                        COUNT(DISTINCT subject) AS subjects,
                        COUNT(DISTINCT predicate) AS predicates,
                        COUNT(DISTINCT relationshipId) AS relationships
                 FROM \"$table\";"
        ;;
      *)
        printf 'profile supports entity or stable_graph only.\n' >&2
        exit 2
        ;;
    esac
    ;;
  predicate-summary)
    require_database
    run_sql "SELECT predicate, COUNT(*) AS facts
             FROM stable_graph
             GROUP BY predicate
             ORDER BY facts DESC, predicate
             LIMIT 25;"
    ;;
  query)
    require_database
    sql="${2:-}"
    if [ -z "$sql" ]; then
      printf 'A read-only SQL statement is required.\n' >&2
      exit 2
    fi
    case "$sql" in
      [Ss][Ee][Ll][Ee][Cc][Tt]*|[Ww][Ii][Tt][Hh]*|[Ee][Xx][Pp][Ll][Aa][Ii][Nn]*|[Pp][Rr][Aa][Gg][Mm][Aa]*)
        run_sql "$sql"
        ;;
      *)
        printf 'Only SELECT, WITH, EXPLAIN, and PRAGMA statements are accepted.\n' >&2
        exit 2
        ;;
    esac
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

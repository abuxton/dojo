{
    "_comment": "NomadOS init configuration - mirrors config/init.json from https://github.com/jboero/nomados",
    "_comment2": "In NomadOS this file lives at /etc/nomad/init.json and is read by Nomad at boot (PID 1 equivalent).",
    "data_dir": "/var/lib/nomad/data",
    "datacenter": "dc1",
    "client": {
        "enabled": true,
        "options": {
            "user.denylist": "",
            "user.checked_drivers": "exec,raw_exec"
        },
        "server_join": {
            "retry_join": ["nomad-server", "172.20.0.10"],
            "retry_max": 10,
            "retry_interval": "1s"
        },
        "state_dir": "/var/lib/nomad/client"
    },
    "server": {
        "enabled": false
    },
    "log_level": "DEBUG",
    "bind_addr": "0.0.0.0"
}
